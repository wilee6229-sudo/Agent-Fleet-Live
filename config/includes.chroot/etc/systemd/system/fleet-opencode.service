[Unit]
Description=Fleet — opencode
After=network.target

[Service]
Type=simple
User=agent
WorkingDirectory=/home/agent/fleet
Restart=on-failure
RestartSec=5
Environment=HOME=/home/agent
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/home/agent/.local/bin
ExecStart=/usr/bin/opencode --auto

[Install]
WantedBy=multi-user.target
