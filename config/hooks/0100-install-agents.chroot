#!/bin/sh
set -e
echo "=== AGENT FLEET CHROOT HOOK ==="

# Every network/install step below is wrapped in `timeout <secs>` so a silent
# hang (interactive prompt, stalled download) FAILS FAST with a visible error
# instead of stalling the whole CI build for hours.

# Node.js
timeout 300 curl -fsSL https://deb.nodesource.com/setup_24.x | bash -
timeout 600 apt-get install -y nodejs

# Cloudflared — official repo (key URL changed 2025; cloudflare-main.gpg is current)
timeout 120 curl -fsSL https://pkg.cloudflare.com/cloudflare-main.gpg | gpg --dearmor -o /usr/share/keyrings/cloudflared.gpg
echo "deb [signed-by=/usr/share/keyrings/cloudflared.gpg] https://pkg.cloudflare.com/cloudflared $(lsb_release -cs) main" > /etc/apt/sources.list.d/cloudflared.list
timeout 600 apt-get update && timeout 600 apt-get install -y cloudflared

# Python packages — hermes-agent (NOT hermes-cli squat), aider, mistral-vibe (NOT bare vibe:
# pypi "vibe" is an unrelated broken sdist that fails metadata generation), huggingface_hub (hf CLI)
#
# PIP BACKTRACKING FIX: hermes-agent pins httpx[socks]==0.28.1; aider-chat and mistral-vibe
# pin httpcore==1.0.9 + httpx==0.28.1; litellm wants httpx<1.0,>=0.28.0. These are COMPATIBLE,
# but resolving them all in ONE pip command makes pip walk down through every httpcore version
# (~5 min each) then every hermes-agent version (~50 min each) — it NEVER completes.
# Fix: pre-pin the shared pins, install hermes-agent alone, then the rest. No backtracking.
#
# DPKG/PIP CONFLICT FIX (run 30778933444, all 4): Ubuntu 24.04 ships python packages as
# dpkg-managed installs (python3-yaml=PyYAML, python3-typing-extensions, python3-requests, ...).
# When pip needs to change one of them it tries to uninstall it and dies with:
#   "Cannot uninstall <pkg>, RECORD file not found. Hint: The package was installed by debian."
# This hit typing_extensions (build 6) then PyYAML (build 7) — a whack-a-mole, one package at a
# time. --ignore-installed on EVERY pip line kills the whole error class: pip never attempts an
# uninstall, it just installs over the debian files. We own the files pip touches.
timeout 600 pip3 install --break-system-packages --ignore-installed "httpx[socks]==0.28.1" "httpcore==1.0.9"
timeout 120 pip3 install --break-system-packages --ignore-installed typing_extensions
timeout 600 pip3 install --break-system-packages --ignore-installed hermes-agent
timeout 1200 pip3 install --break-system-packages --ignore-installed fastapi uvicorn requests aiohttp litellm qdrant-client aider-chat mistral-vibe huggingface_hub

# NPM packages — --unsafe-perm for global installs.
# @gitlawb/openclaude (NOT bare openclaude squat); kimi-code npm-only (pip version conflicts on bin);
# qwen-code via @qwen-code/qwen-code (pip package does not exist)
timeout 1200 npm install -g --unsafe-perm opencode-ai openclaw @gitlawb/openclaude 9router pm2 @24klynx/cli @mem0/cli agent-browser oh-my-opencode @qwen-code/qwen-code kimi-code free-claude-code @google/gemini-cli @gitlawb/zero cursor-agent @openai/codex eas-cli aion nemoclaw freebuff byterover-cli yarn pnpm

# ZeroClaw — non-fatal: network hiccups must not fail the build
timeout 300 curl -fsSL https://raw.githubusercontent.com/zeroclaw-labs/zeroclaw/master/install.sh | bash || echo "WARN: zeroclaw install failed, continuing"

# OpenGateway — non-fatal
timeout 300 curl -fsSL https://gitlawb.com/install.sh | bash || echo "WARN: opengateway install failed, continuing"

# open-grok — shell installer, OAuth login, no API key. Non-fatal.
timeout 300 curl -fsSL https://github.com/mweinbach/open-grok/releases/latest/download/install.sh | bash || echo "WARN: open-grok install failed, continuing"

# llama.cpp — prebuilt ubuntu x64 tarball (b10235, ~16MB), NO source build.
# User prefers llama.cpp over ollama. Models are user-downloaded at runtime (GBs each, not shipped).
mkdir -p /opt/llama.cpp && cd /opt/llama.cpp
timeout 600 curl -fsSL https://github.com/ggml-org/llama.cpp/releases/download/b10235/llama-b10235-bin-ubuntu-x64.tar.gz -o llama.tar.gz \
  && tar -xzf llama.tar.gz --strip-components=1 && rm -f llama.tar.gz \
  && ln -sf /opt/llama.cpp/llama-cli /usr/local/bin/llama-cli \
  && ln -sf /opt/llama.cpp/llama-server /usr/local/bin/llama-server \
  || echo "WARN: llama.cpp install failed, continuing"

# User setup
useradd -m -s /bin/bash -G sudo,video,input,audio,seat,render agent 2>/dev/null || true
echo "agent:agent" | chpasswd
echo "agent ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/agent
mkdir -p /home/agent/fleet/{logs,inboxes,backups,config}
chown -R agent:agent /home/agent/fleet
chown -R agent:agent /home/agent
echo "=== HOOK COMPLETE ==="
